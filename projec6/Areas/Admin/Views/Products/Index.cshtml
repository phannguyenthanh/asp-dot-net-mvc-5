@model IEnumerable<project5.Models.Product>

@{
    ViewBag.Title = "Danh mục";
    ViewBag.Name = "Sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout_list.cshtml";
}


<h2>@ViewBag.Name </h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>




<div class="row">
    <div class="col-xs-12">

        <!-- /.box -->
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Data Table With Full Features</h3>
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                <table id="example1" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tên sp</th>
                            <th>Loại sản phẩm</th>
                            <th>Ảnh</th>
                            <th>Giảm giá</th>

                            <th>Giá</th>
                            <th>Lượi xem</th>
                            <th>Hiển thị</th>
                            <th>Ngày tạo</th>
                            <th>
                                Công cụ
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.Category.Name)</td>
                                <td>

                                    <img src="@Html.DisplayFor(modelItem => item.Image)" alt="Alternate Text" width="100" />
                                </td>
                                <td>
                                  
                                                                @if (item.Sale == 0)
                                                                {
                                                                    <span>_</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>@item.Sale %</span>
                                                                }
                                                            </td>
                                <td>@String.Format("{0:0,0 vnđ}", item.Price) </td>
                                <td>
                                    @if (item._View == null)
                                    {
                                        <span>_</span>
                                    }
                                    else
                                    {
                                        <span>@item._View</span>
                                    }

                                                            </td>
                                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                <td>@Html.DisplayFor(modelItem => item.Createtime)</td>
                                <td>
                                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                                </td>
                            </tr>
                        }


                    </tbody>
                    <tfoot>
                        <tr>
                            <th>ID</th>
                            <th>Tên sp</th>
                            <th>Loại sản phẩm</th>
                            <th>Ảnh</th>
                            <th>Giảm giá</th>

                            <th>Giá</th>
                            <th>Lượt xem</th>
                            <th>Hiển thị</th>
                            <th>Ngày tạo</th>
                            <th>
                                Công cụ
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
    <!-- /.col -->
</div>



