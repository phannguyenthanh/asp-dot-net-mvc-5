                <a href="#" id="btnDeleteAll" style="background:#d43f3a;" class=" to-buy">Xoá giỏ hàng</a>

                <a href="#" id="btnBayment" class=" to-buy">Thanh thoán</a>

            </div>
            <div class="col-lg-3  text-center" style="line-height:30px;margin-top:12px">
                Tổng tiền thanh toán :  @ViewBag.total_payment đ
            </div>

            <div class="clearfix"> </div>
