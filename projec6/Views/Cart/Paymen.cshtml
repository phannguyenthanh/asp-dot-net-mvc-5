                        <div class="clearfix"> </div>
                    </td>
                    <td class="check">

                        <input type="number" class="quality_buy" data-id="@item.Product.Id" value="@item.Quantity" style="width:40px;text-align:center;" min="0" max="@item.Product.Quantity"><label>/ @item.Product.Quantity</label>

                    </td>
                    <td>@item.Product.Price.Value.ToString("N0")</td>
