
@model IEnumerable<project5.Models.Product>
<div class="content-top1">
    @foreach (var i in Model)
    {
        <div class="col-md-4 col-md3">
            <div class="col-md1 simpleCart_shelfItem">
                <a href="@Url.Action("index","Details",new{id = i.Id})">
                    <img class="img-responsive" src="@i.Image" alt="" />
                </a>
                <h3><a href="@Url.Action("index","Details",new{id = i.Id})">@i.Name</a></h3>
                <div class="price">
                    <h5 class="item_price">@i.Price.Value.ToString("N0") đ</h5>
                    <a href="#" class="item_add">Thêm</a>
                    <div class="clearfix"> </div>
                </div>
            </div>
        </div>

    }
    <div class="clearfix"> </div>
</div>